d", "contents": [{"content": "dream", "type": "name"}, {"content": "something that is beautiful, excellent or pleasing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Paris is a dream!", "type": "example"}, {"content": "engenn4le01ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when writing a letter about a place in a city.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "wish you were here", "type": "name"}, {"content": "use this to say you miss someone", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example:  I wish you were here in Paris with me!", "type": "example"}, {"content": "engenn4le01ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "menu board ", "type": "name"}, {"content": "a board on which you write a food menu", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  People write on the menu board.", "type": "example"}, {"content": "engenn4le01ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "along", "type": "name"}, {"content": "in a line", "type": "definition"}, {"content": "(preposition)", "type": "part_speech"}, {"content": "Example:  The menu boards are along the sidewalk.", "type": "example"}, {"content": "engenn4le01ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sidewalk", "type": "name"}, {"content": "a concrete path along the side of a street for people to walk on", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Walk on the sidewalk, not on the road.", "type": "example"}, {"content": "engenn4le01ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "a little bit", "type": "name"}, {"content": "a small amount", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You can see a little bit of Paris.", "type": "example"}, {"content": "engenn4le01ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to light up ", "type": "name"}, {"content": "to fill up; illuminate", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The Eiffel Tower lights up the sky at night.", "type": "example"}, {"content": "engenn4le01ob02aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sky", "type": "name"}, {"content": "the space where the sun and moon appear", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It lights up the entire sky.", "type": "example"}, {"content": "engenn4le01ob02aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "entry", "type": "name"}, {"content": "something that is posted on a blog", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm a posting a new entry on my blog.", "type": "example"}, {"content": "engenn4le01ob02aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "adventure ", "type": "name"}, {"content": "an exciting experience", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I am enjoying this adventure!", "type": "example"}, {"content": "engenn4le01ob02aud10", "type": "audio"}]}, {"content": "engenn4le01ob02re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Go on the Internet.", "type": "text"}, {"content": "Listen to the song, \"Wish You Were Here\" by Pink Floyd. ", "type": "text"}, {"content": "Find the lyrics to this song. Print them.", "type": "text"}, {"content": "Circle all the verbs in the Simple Present tense.", "type": "text"}, {"content": "Change those verbs into the Present Continuous tense.", "type": "text"}]}, {"type": "takeaway_assessment", "co