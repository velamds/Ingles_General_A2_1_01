, "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "id": 0, "correct": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn4le01ob03re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Select a city you plan to go to.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "video", "title": "", "contents": [{"type": "video", "value": {"video_src": "engenn4le01ob03re2vid01", "images": [{"image": "", "text": "", "time": "0", "id": 0}, {"image": "", "text": "Paris is a very old but also very modern city, with something for everyone. There's so much to do! I'm strolling through the neighborhoods this afternoon with a guide. We're seeing some of the art at the museums.", "time": "50", "id": 1}, {"image": "", "text": "Later, I'm going to go window-shopping for designer clothing. Some famous designers work in Paris. I intend to visit these shops.", "time": "16500", "id": 2}, {"image": "", "text": "There are excellent restaurants in Paris. French cooking is famous. I'm checking out a restaurant and a wine bar with the guide tomorrow. Paris is any sweet tooth's dream! I'm drooling just sitting here thinking about the macaroons. You can bet I intend to eat a lot of those. I'm going to post an entry about them later.", "time": "27000", "id": 3}]}}], "id": 3}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "It's Time to Travel", "type": "lesson_name"}, {"content": "So Much to Do!", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "scholar > Out and About in the City > Greetings From Costa Rica!", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_1"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_2"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_3"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_4"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_5"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_6"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_7"}, {"content": "Gives appropriate directions to places taking into account the type of interlocutor.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Present Continuous vs. Be Going To", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Continuous</span> and <span class=\"strong\">be going to</span> to talk about future actions and events. <br><Br>You use the <span class=\"strong\">Present Continuous</span> to talk about arrangements and plans. <span class=\"strong\">Be going to</span> puts an emphasis on the idea of intention (you decide to do something). <br><br>Example: <span class=\"italic\">I'm meeting with the tour group this afternoon. <span class=\"strong\">vs.</span> I'm going to meet the guide this week. </span> <br><br> You can use <span class=\"strong\">intend to</span> in place of <span class=\"strong\">be going to</span>.", "type": "describer"}, {"content": "I'm visiting a restaurant. ", "type": "example"}, {"content": "I'm checking out the wine bar.", "type": "example"}, {"content": "I'm going to go to the museum today.", "type": "example"}, {"content": "Are you going sightseeing today?", "type": "example"}, {"content": "I intend to go on a walk.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "old ", "type": "name"}, {"content": "something that exists for a long time", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Paris is an old city.", "type": "example"}, {"content": "engenn4le01ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about Paris.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "art", "type": "name"}, {"content": "paintings, drawings", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There's great art in the museums.", "type": "example"}, {"content": "engenn4le01ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "window-shopping", "type": "name"}, {"content": "the activity of looking at goods in shop windows without intending to buy them", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm going to go window-shopping for clothing.", "type": "example"}, {"content": "engenn4le01ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "designer", "type": "name"}, {"content": "a person who makes plans or patterns for clothes", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  Many designers work in Paris.", "type": "example"}, {"content": "engenn4le01ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to intend", "type": "name"}, {"content": "to have something in your mind; have an objective", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I intend on visiting these shops.", "type": "example"}, {"content": "engenn4le01ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "wine bar", "type": "name"}, {"content": "a small restaurant where wine is the main drink available", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm going to check out a wine bar in Paris.", "type": "example"}, {"content": "engenn4le01ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sweet tooth", "type": "name"}, {"content": "a strong liking for sweet food ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Paris is any sweet tooth's dream!", "type": "example"}, {"content": "engenn4le01ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to drool ", "type": "name"}, {"content": "to let saliva come out of your mouth", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm drooling just thinking about all these desserts!", "type": "example"}, {"content": "engenn4le01ob03aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "macaroon", "type": "name"}, {"content": "a small round cake", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Paris is famous for its macaroons.", "type": "example"}, {"content": "engenn4le01ob03aud09", "type": "audio"}]}, {"content": "engenn4le01ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose a city.", "type": "text"}, {"content": "Go on the Internet. Find places and things to do in this city.", "type": "text"}, {"content": "Write 3 sentences about where you intend to go.", "type": "text"}, {"content": "Write 3 sentences about what you plan to do.", "type": "text"}, {"content": "Write 3 sentences starting with <span class=\"italic\">I'm going to ...</span>", "type": "text"}, {"content": "Read your sentences aloud to your class.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about my plans and intentions.", "type": "text"}, {"content": "I use the Present Continuous tense.", "type": "text"}, {"content": "I use <span class=\"italic\">Going to</span>. ", "type": "text"}, {"content": "I read my sentences aloud.", "type": "text"}]}]}