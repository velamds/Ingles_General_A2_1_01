ent_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Requesting Information"}, {"type": "describer", "content": "When you are on vacation, it is common to ask for information. You can request information in public places, using modals for request: can, could, would ... Remember to be polite.<br/> <br />You can use the expressions: <br />   <ul><li><span class=\"italic\">Can/Could I ask you ...</span>    </li> <li><span class=\"italic\">Can/Could you tell me ... ?</span> </li>  <li><span class=\"italic\">I'd like to know ...</span> </li> <li><span class=\"italic\">Would/Do you happen to know \u2026 ?</span> </li></ul>"}, {"type": "example", "content": "<span class =\"strong\">Emily</span>: Could you tell me where the souvenir shop is?<br /><span class =\"strong\">Guide</span>: Sure."}, {"type": "example", "content": "<span class =\"strong\">Matt</span>: I'd like to know where the Arc is.<br />             <span class =\"strong\">Stranger</span>: Take the Metro. Get off at the next station."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "roundabout "}, {"type": "definition", "content": "a circular area where three or more roads join together  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Walk straight down to the roundabout."}, {"type": "audio", "content": "engenn4le01ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": ""}]}, {"type": "target_word", "contents": [{"type": "name", "content": "souvenir "}, {"type": "definition", "content": "an object you buy from a place you visit "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Where can I buy a souvenir?"}, {"type": "audio", "content": "engenn4le01ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "arch "}, {"type": "definition", "content": "a structure with a curved top and straight sides  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Where is the Arc de Triomphe? "}, {"type": "audio", "content": "engenn4le01ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to shop for "}, {"type": "definition", "content": "to go to a shop to buy specific things "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I have to shop for souvenirs!"}, {"type": "audio", "content": "engenn4le01ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "exit "}, {"type": "definition", "content": "the space where you leave a public place from "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Please use the other exit in the station."}, {"type": "audio", "content": "engenn4le01ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": " key chain "}, {"type": "definition", "content": "people use it to hold their keys"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I bought some key chains."}, {"type": "audio", "content": "engenn4le01ob06aud06"}]}, {"type": "background_image", "content": "engenn4le01ob06re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "You are at a Metro station. You want to know which line to take."}, {"type": "text", "content": "Request information from the attendant. Write a dialogue (5 - 7 lines)."}, {"type": "text", "content": "Practice your dialogue with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I request information."}, {"type": "text", "content": "I use the Present Simple and Present Continuous tenses. "}, {"type": "text", "content": "I practice my dialogue."}]}], "type": "sena"}