]}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le01ob06re2aud01", "coverimg": "engenn4le01ob06re2img05.jpg", "images": [{"image": "engenn4le01ob06re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn4le01ob06re2img05.jpg", "text": "<span class =\"strong\">Attendant</span>: Excuse me. Please use the other exit next to the ticket booth.<br />\n<span class =\"strong\">Sally</span>: Oh, okay. I'd like to know where the Arc de Triomphe is.<br />\n<span class =\"strong\">Attendant</span>: It's the next stop but you can walk from here. Just exit here and walk straight down until the roundabout. <br />\n<span class =\"strong\">Sally</span>: Thanks.<br />\n<span class =\"strong\">Attendant</span>: You're welcome.", "id": 1, "time": "10200"}, {"image": "engenn4le01ob06re2img02.jpg", "text": "<span class =\"strong\">Sally</span>: There are so many shops! I can buy souvenirs here.<br />\n<span class =\"strong\">Passerby</span>: Excuse me Miss, can I ask you a question?<br />\n<span class =\"strong\">Sally</span>: Sure.<br />\n<span class =\"strong\">Passerby</span>: I'm shopping for souvenirs. Do you happen to know where the gift shops are?<br />\n<span class =\"strong\">Sally</span>: Umm ... sorry. I'm not from here. I'm a tourist too.<br />", "id": 2, "time": "39200"}, {"image": "engenn4le01ob06re2img02.jpg", "text": "<span class =\"strong\">Passerby</span>: Where are you from?<br />\n<span class =\"strong\">Sally</span>: America. You?<br />\n<span class =\"strong\">Passerby</span>: Canada. Where are you going?<br />\n<span class =\"strong\">Sally</span>: I'm heading to the Arc. Buy anything yet?<br />", "id": 3, "time": "57000"}, {"image": "engenn4le01ob06re2img03.jpg", "text": "<span class =\"strong\">Passerby</span>: I bought some key chains. Nice meeting you!", "id": 4, "time": "68000"}]}}], "id": 2}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "It's Time to Travel", "type": "lesson_name"}, {"content": "Shopping for Souvenirs", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Out and About in the City > Paris", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations about advice for a healthy lifestyle.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Requesting Information", "type": "heading"}, {"content": "When you are on vacation, it is common to ask for information. You can request information in public places, using modals for request: <span class=\"italic\">can, could, would </span... Remember to be polite.<br/> <br />You can use the expressions: <br />   <ul><li><span class=\"italic\">Can/Could I ask you ...</span>    </li> <li><span class=\"italic\">Can/Could you tell me ... ?</span> </li>  <li><span class=\"italic\">I'd like to know ...</span> </li> <li><span class=\"italic\">Would/Do you happen to know \u2026 ?</span> </li></ul>", "type": "describer"}, {"content": "<span class =\"strong\">Emily</span>: Could you tell me where the souvenir shop is?<br /><span class =\"strong\">Guide</span>: Sure.", "type": "example"}, {"content": "<span class =\"strong\">Matt</span>: I'd like to know where the Arc is.<br />             <span class =\"strong\">Stranger</span>: Take the Metro. Get off at the next station.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "roundabout ", "type": "name"}, {"content": "a circular area where three or more roads join together  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Walk straight down to the roundabout.", "type": "example"}, {"content": "engenn4le01ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you hear when you travel.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "souvenir ", "type": "name"}, {"content": "an object you buy from a place you visit ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Where can I buy a souvenir?", "type": "example"}, {"content": "engenn4le01ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "arch ", "type": "name"}, {"content": "a structure with a curved top and straight sides  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Where is the Arc de Triomphe? ", "type": "example"}, {"content": "engenn4le01ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to shop for ", "type": "name"}, {"content": "to go to a shop to buy specific things ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I have to shop for souvenirs!", "type": "example"}, {"content": "engenn4le01ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "exit ", "type": "name"}, {"content": "the space where you leave a public place from ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Please use the other exit in the station.", "type": "example"}, {"content": "engenn4le01ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": " key chain ", "type": "name"}, {"content": "people use it to hold their keys", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I bought some key chains.", "type": "example"}, {"content": "engenn4le01ob06aud06", "type": "audio"}]}, {"content": "engenn4le01ob06re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "You are at a Metro station. You want to know which line to take.", "type": "text"}, {"content": "Request information from the attendant. Write a dialogue (5-7 lines).", "type": "text"}, {"content": "Practice your dialogue with a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I request information.", "type": "text"}, {"content": "I use the Present Simple and Present Continuous tenses. ", "type": "text"}, {"content": "I practice my dialogue.", "type": "text"}]}]}