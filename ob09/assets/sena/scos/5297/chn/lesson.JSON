se to say something is located on the left side"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: The building on your left is the city hall."}, {"type": "audio", "content": "engenn4le01ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "former"}, {"type": "definition", "content": "existing in the past"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: This was the former residence of the royal family."}, {"type": "audio", "content": "engenn4le01ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cathedral "}, {"type": "definition", "content": "the main church of an area"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Here is the famous cathedral of Paris."}, {"type": "audio", "content": "engenn4le01ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "royal palace"}, {"type": "definition", "content": "the official home of a king or queen"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The Conciergerie was the former royal palace."}, {"type": "audio", "content": "engenn4le01ob09aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to design"}, {"type": "definition", "content": "to make a drawing of something that is going to be built"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The Eiffel Tower was designed by Stephen Sauvestre."}, {"type": "audio", "content": "engenn4le01ob09aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "complex "}, {"type": "definition", "content": "a group of buildings"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: On your left is an old complex."}, {"type": "audio", "content": "engenn4le01ob09aud08"}]}, {"type": "target_word", "contents": [{"type":