uli_ids": [], "id": 11, "type": "TYP", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "What is happening? Let's find out. "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Read the sentences. Type in the missing words. Use <span class=\"product-color-text\">shop for</span>, <span class=\"product-color-text\">go</span>, <span class=\"product-color-text\">help</span>, <span class=\"product-color-text\">looking</span>, <span class=\"product-color-text\">visiting</span>."}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "It's Time to Travel"}, {"type": "unit_name", "content": "Vanessa in Mexico"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 1}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_7", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_8", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Travel English"}, {"type": "describer", "content": "When you are on vacation, it is common to ask for information from strangers in public places. You can use the expressions and modals for requests:<br><br><li> <span class=\"italic\">Can/Could you tell/help me ... ?</span> </li><li><span class=\"italic\">I'd like to know ...</span></li><li><span class=\"italic\">Would/Do you happen to know ... ?</li></span><br>Another way to ask for information is to use <span class=\"strong\">Wh-</span> words. The  <span class=\"strong\">Wh-</span>question words are: <span class=\"italic\">what</span>, <span class=\"italic\">when</span>, <span class=\"italic\">where</span>, <span class=\"italic\">who</span>, and <span class=\"italic\">why</span>. You can use <span class=\"strong\">What </span>to ask for information like <span class=\"italic\">What can I do on a Sunday?</span> You can use  <span class=\"strong\"> Where</span> to ask for directions to places in a city and adjectives to describe the places. <br><br> When you give directions, use Imperatives, expressions and prepositions of place."}, {"type": "example", "content": "<span class=\"strong\">Chelsea</span>: Excuse me. Can you help me?       <br>      <span class=\"strong\">Guide</span>: Of course.            <br> <span class=\"strong\">Chelsea</span>: Would you happen to know where the souvenir shop is?         <br>  <span class=\"strong\"> Guide</span>: Head north on Main Street. It's next to the corner shop."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "attraction "}, {"type": "definition", "content": "a well-known place in a city"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: What attractions should I visit? "}, {"type": "audio", "content": "engenn4le01ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to say where places are in a city. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ice cream parlor "}, {"type": "definition", "content": "a shop selling ice cream"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There is an ice cream parlor opposite the market. "}, {"type": "audio", "content": "engenn4le01ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "souvenir"}, {"type": "definition", "content": "an object that you buy from a place you visit"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Where can I buy a souvenir?"}, {"type": "audio", "content": "engenn4le01ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to shop for"}, {"type": "definition", "content": "to go to a shops to buy specific things"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I have to shop for souvenirs!"}, {"type": "audio", "content": "engenn4le01ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Metro "}, {"type": "definition", "content": "an underground railway system "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You can take the metro to the market."}, {"type": "audio", "content": "engenn4le01ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "exit"}, {"type": "definition", "content": "a space where you leave a public place "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Use the other exit in the station."}, {"type": "audio", "content": "engenn4le01ob11aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "north"}, {"type": "definition", "content": "the direction that is at the top of a map"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Head north on this street."}, {"type": "audio", "content": "engenn4le01ob11aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "on your left"}, {"type": "definition", "content": "use to say something is located on the left side"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: The market is on your left."}, {"type": "audio", "content": "engenn4le01ob11aud08"}]}, {"type": "background_image", "content": "engenn4le01ob11re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a dialogue (5-8 lines) between a tourist and a tour guide."}, {"type": "text", "content": "The tourist is requesting information."}, {"type": "text", "content": "Read your dialogue aloud with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write 5-8 lines."}, {"type": "text", "content": "I ask where places are in a city."}, {"type": "text", "content": "I give directions."}]}], "type": "sena"}